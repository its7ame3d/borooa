# Copy this file to .env.local and fill in your mail server's real credentials.
# .env.local is gitignored and never committed.

SMTP_HOST=mail.borooa.com
SMTP_PORT=587
SMTP_USER=hello@borooa.com
SMTP_PASS=your-smtp-password
# Optional: set to "true" for port 465 (implicit TLS). Defaults based on port.
# SMTP_SECURE=false

# Optional overrides (default to hello@borooa.com / SMTP_USER):
# ORDER_NOTIFICATION_EMAIL=hello@borooa.com
# MAIL_FROM=hello@borooa.com
